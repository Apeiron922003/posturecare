{
  "name": "posturecare-web",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && python3 -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --prefix apps/web",
    "test": "npm run test --prefix apps/web",
    "test:api": "cd apps/api && python3 -m pytest -q",
    "test:web": "npm run test --prefix apps/web",
    "postinstall": "npm install --prefix apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
